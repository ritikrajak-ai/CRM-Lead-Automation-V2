        "jsCode": "const error = ($json.error_message || \"\").toLowerCase();\n\nlet category = \"unknown\";\nlet retryable = false;\n\n\n// =========================\n// RETRYABLE ERRORS\n// =========================\n\nif (\n\n  // Database temporary issues\n  error.includes(\"database\") ||\n  error.includes(\"db timeout\") ||\n  error.includes(\"database timeout\") ||\n  error.includes(\"connection timeout\") ||\n\n  // Network issues\n  error.includes(\"network\") ||\n  error.includes(\"econnreset\") ||\n  error.includes(\"econnrefused\") ||\n  error.includes(\"enotfound\") ||\n  error.includes(\"socket hang up\") ||\n  error.includes(\"connection lost\") ||\n  error.includes(\"connection closed\") ||\n\n  // Timeout issues\n  error.includes(\"timeout\") ||\n  error.includes(\"timed out\") ||\n  error.includes(\"request timeout\") ||\n  error.includes(\"gateway timeout\") ||\n\n  // Rate limiting\n  error.includes(\"rate limit\") ||\n  error.includes(\"429\") ||\n  error.includes(\"too many requests\") ||\n\n  // Temporary server failures\n  error.includes(\"500\") ||\n  error.includes(\"502\") ||\n  error.includes(\"503\") ||\n  error.includes(\"504\") ||\n  error.includes(\"internal server error\") ||\n  error.includes(\"service unavailable\") ||\n  error.includes(\"bad gateway\") ||\n\n  // Temporary external service failures\n  error.includes(\"provider unavailable\") ||\n  error.includes(\"service temporarily unavailable\") ||\n  error.includes(\"temporary failure\") ||\n\n  // AI/LLM temporary failures\n  error.includes(\"llm timeout\") ||\n  error.includes(\"model unavailable\") ||\n  error.includes(\"token limit exceeded\")\n\n) {\n\n  category = \"temporary_failure\";\n  retryable = true;\n\n}\n\n\n// =========================\n// NON-RETRYABLE ERRORS\n// =========================\n\nelse if (\n\n  // Validation errors\n  error.includes(\"validation\") ||\n  error.includes(\"required field\") ||\n  error.includes(\"missing field\") ||\n  error.includes(\"invalid data\") ||\n  error.includes(\"invalid format\") ||\n\n  // Authentication / Authorization\n  error.includes(\"401\") ||\n  error.includes(\"unauthorized\") ||\n  error.includes(\"invalid credential\") ||\n  error.includes(\"invalid token\") ||\n  error.includes(\"403\") ||\n  error.includes(\"forbidden\") ||\n  error.includes(\"permission denied\") ||\n\n  // Duplicate data\n  error.includes(\"duplicate\") ||\n  error.includes(\"already exists\") ||\n  error.includes(\"unique constraint\") ||\n  error.includes(\"duplicate key\") ||\n\n  // Business logic errors\n  error.includes(\"business rule\") ||\n  error.includes(\"not allowed\") ||\n  error.includes(\"operation rejected\") ||\n\n  // Resource errors\n  error.includes(\"404\") ||\n  error.includes(\"not found\") ||\n  error.includes(\"resource unavailable\") ||\n\n  // AI permanent failures\n  error.includes(\"invalid json response\") ||\n  error.includes(\"unsupported request\") ||\n\n  // Data format problems\n  error.includes(\"parse error\") ||\n  error.includes(\"syntax error\")\n\n) {\n\n  category = \"permanent_failure\";\n  retryable = false;\n\n}\n\n\n// =========================\n// UNKNOWN ERRORS\n// =========================\n\nelse {\n\n  category = \"unknown_failure\";\n  retryable = false;\n\n}\n\n\nreturn {\n  json: {\n    ...$json,\n    normalized_error: error,\n    error_category: category,\n    retryable: retryable\n  }\n};"
